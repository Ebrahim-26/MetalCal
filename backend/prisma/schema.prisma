// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Entry {
  id            Int           @id @default(autoincrement())

  weight        Int
  actualWeight  Int

  jumboBag      Int
  jumboBagWg    Int

  smallBag      Int
  smallBagWg    Int

  selectedMetal Int

  metalWeight   Int

  wastage       Int
  totalWastage  Int

  otherMetalsWg Int

  otherMetals   OtherMetal[]

  createdAt     DateTime      @default(now())
}

model OtherMetal {
  id      Int    @id @default(autoincrement())
  name    Int?
  weight  Int

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId Int
}
